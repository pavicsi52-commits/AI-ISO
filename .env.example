# AI-IOS Environment Configuration
# Copy to .env and fill in real values. Never commit .env.
# All variables are prefixed AIIOS_ per docs/013_Configuration_Framework.md.txt.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
AIIOS_ENVIRONMENT=development
AIIOS_APP_NAME=ai-ios
AIIOS_APP_VERSION=0.1.0
AIIOS_DEBUG=true
AIIOS_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Gateway Service
# ---------------------------------------------------------------------------
AIIOS_GATEWAY_HOST=0.0.0.0
AIIOS_GATEWAY_PORT=8000

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
AIIOS_DATABASE_HOST=localhost
# 5433: avoids colliding with a native PostgreSQL install that may already
# occupy the standard 5432 on the host machine.
AIIOS_DATABASE_PORT=5433
AIIOS_DATABASE_NAME=aiios
AIIOS_DATABASE_USER=aiios
AIIOS_DATABASE_PASSWORD=change-me
AIIOS_DATABASE_POOL_MIN=5
AIIOS_DATABASE_POOL_MAX=20

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
AIIOS_REDIS_HOST=localhost
AIIOS_REDIS_PORT=6379
AIIOS_REDIS_PASSWORD=change-me
AIIOS_REDIS_DB=0

# ---------------------------------------------------------------------------
# RabbitMQ
# ---------------------------------------------------------------------------
AIIOS_RABBITMQ_HOST=localhost
AIIOS_RABBITMQ_PORT=5672
AIIOS_RABBITMQ_MANAGEMENT_PORT=15672
AIIOS_RABBITMQ_USER=aiios
AIIOS_RABBITMQ_PASSWORD=change-me
AIIOS_RABBITMQ_VHOST=/aiios

# ---------------------------------------------------------------------------
# Neo4j
# ---------------------------------------------------------------------------
AIIOS_NEO4J_HOST=localhost
AIIOS_NEO4J_BOLT_PORT=7687
AIIOS_NEO4J_HTTP_PORT=7474
AIIOS_NEO4J_USER=neo4j
AIIOS_NEO4J_PASSWORD=change-me-min-8-chars

# ---------------------------------------------------------------------------
# MinIO
# ---------------------------------------------------------------------------
AIIOS_MINIO_HOST=localhost
AIIOS_MINIO_PORT=9000
AIIOS_MINIO_CONSOLE_PORT=9001
AIIOS_MINIO_ACCESS_KEY=aiios
AIIOS_MINIO_SECRET_KEY=change-me-min-8-chars
AIIOS_MINIO_USE_SSL=false

# ---------------------------------------------------------------------------
# OpenSearch
# ---------------------------------------------------------------------------
AIIOS_OPENSEARCH_HOST=localhost
AIIOS_OPENSEARCH_PORT=9200
AIIOS_OPENSEARCH_USER=admin
AIIOS_OPENSEARCH_PASSWORD=Change-Me-1!

# ---------------------------------------------------------------------------
# Prometheus / Grafana
# ---------------------------------------------------------------------------
AIIOS_PROMETHEUS_PORT=9090
AIIOS_GRAFANA_PORT=3001
AIIOS_GRAFANA_ADMIN_USER=admin
AIIOS_GRAFANA_ADMIN_PASSWORD=change-me

# ---------------------------------------------------------------------------
# Security (JWT — real keys generated per environment, never checked in)
# ---------------------------------------------------------------------------
AIIOS_JWT_ALGORITHM=RS256
AIIOS_JWT_PRIVATE_KEY_PATH=./configs/development/keys/jwt_private.pem
AIIOS_JWT_PUBLIC_KEY_PATH=./configs/development/keys/jwt_public.pem
AIIOS_JWT_ACCESS_TOKEN_TTL_SECONDS=900
AIIOS_JWT_REFRESH_TOKEN_TTL_SECONDS=604800

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_ENV=development
